# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Server-only: SMTP settings for the "Request Info" form ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for implicit TLS (usually port 465), "false" for STARTTLS (587)
SMTP_SECURE=false
SMTP_USER=forms@example.com
SMTP_PASS=change-me
# Optional; defaults to SMTP_USER
SMTP_FROM="Future of the Youth <forms@example.com>"
# Inbox that receives form submissions
FORM_TO_EMAIL=staff@example.com

# --- Public: inlined into the client bundle at build time. No secrets. ---
# Canonical site origin for SEO (canonical URL, sitemap, Open Graph, JSON-LD).
# Optional on Vercel production (falls back to VERCEL_PROJECT_PRODUCTION_URL).
NEXT_PUBLIC_SITE_URL=https://www.example.org
# Official Zeffy donation page. Must be an https:// zeffy.com URL, or the
# Donate Now buttons fall back to the /donate page.
NEXT_PUBLIC_DONATION_URL=https://www.zeffy.com/en-US/donation-form/your-form-id

# --- Public contact details (shown on the site only when set) ---
# The address (Detroit, MI 48235) and EIN are site content in
# lib/content/organization.ts, not settings.
NEXT_PUBLIC_CONTACT_EMAIL=info@example.org
# Optional
NEXT_PUBLIC_CONTACT_PHONE="(313) 555-0100"

# --- Google tag (conversion tracking required by Google Ad Grants) ---
# Leave empty to disable all analytics. When set, the CSP automatically
# allows the Google tag hosts.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion labels from Google Ads (lead = form submissions, donate = Donate Now clicks to Zeffy)
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_DONATE_LABEL=
